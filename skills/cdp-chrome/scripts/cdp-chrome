#!/usr/bin/env bash
#
# cdp-chrome — run a dedicated, logged-in Chrome that CDP clients can attach to
#              unattended (no "Allow remote debugging?" dialog) on Chrome 136+.
#
# WHY THIS EXISTS
#   Chrome 136+ silently ignores --remote-debugging-port on the DEFAULT profile
#   (anti-cookie-theft hardening). chrome-devtools-mcp --autoConnect attaches to
#   your running Chrome and triggers a per-session native consent dialog that no
#   automation can click. The fix: keep a SEPARATE Chrome instance, launched from
#   a NON-default user-data-dir that is a COPY of your real profile. On macOS the
#   Keychain "Chrome Safe Storage" key is per-user (not bound to the profile path),
#   so the copied cookies still decrypt → the dedicated instance is logged in, and
#   because you opened the port yourself there is no dialog. Point your CDP client
#   at  --browserUrl http://127.0.0.1:<PORT>.
#
# PLATFORM: macOS (the Keychain-decrypts-a-copied-profile behavior is macOS-specific;
#   on Linux/Windows the cookie-encryption key binding differs — see SKILL.md).
#
# USAGE
#   cdp-chrome start     # bring the dedicated Chrome up on :PORT (idempotent)
#   cdp-chrome reseed    # refresh the copied profile from your real one (logins)
#   cdp-chrome status    # up / down
#   cdp-chrome config    # print the chrome-devtools-mcp args to use
#   cdp-chrome mode [copied|autoconnect]  # flip chrome-devtools-mcp between the two
#                        # attach modes in ~/.claude.json (no arg = show current). See MODES.
#   cdp-chrome allow-watch  # EXPERIMENTAL: for autoconnect mode, auto-click Chrome's
#                        # "Allow remote debugging?" dialog (bounded osascript loop).
#
# TWO ATTACH MODES (mode switch rewrites mcpServers.chrome-devtools.args in ~/.claude.json)
#   copied      (DEFAULT, recommended) → --browserUrl http://127.0.0.1:<PORT>
#               Attaches to the dedicated copied-profile Chrome this tool runs (start/reseed).
#               No consent dialog ever. Needs `cdp-chrome start` up first.
#   autoconnect (Chrome 144+)          → --autoConnect
#               Attaches chrome-devtools-mcp to your REAL running Chrome (live tabs / real
#               session / LAN). Chrome pops a native "Allow remote debugging?" dialog EVERY
#               session that no automation can suppress; use `allow-watch` to auto-click it.
#
# ENV OVERRIDES (defaults shown)
#   CDP_PORT=9222
#   CDP_PROFILE="$HOME/.cache/cdp-mcp-profile"      # the dedicated (copied) user-data-dir
#   CDP_SOURCE_PROFILE="$HOME/Library/Application Support/Google/Chrome"  # your real user-data-dir
#   CDP_PROFILE_DIR="Default"                        # which profile inside it (e.g. "Profile 1")
#   CDP_CHROME="/Applications/Google Chrome.app"     # the .app BUNDLE (passed to open -a)
#   CDP_ALLOW_ORIGINS=""   (UNSET = no --remote-allow-origins flag; see SECURITY in SKILL.md)
#   CDP_CLAUDE_CONFIG="$HOME/.claude.json"           # MCP host config the mode switch edits
#   CDP_ALLOW_WATCH_SECONDS=60                        # how long `allow-watch` scans before giving up
#
# SECURITY DEFAULT: CDP_ALLOW_ORIGINS is UNSET by default, so --remote-allow-origins is
#   NOT passed. Chrome then accepts only CDP websocket connections with no Origin header
#   (puppeteer / chrome-devtools-mcp / Playwright) and REJECTS origin-bearing connections
#   from web pages — a local page can't hijack the logged-in browser. Set it explicitly
#   (e.g. CDP_ALLOW_ORIGINS="*" or a specific origin) only if your client sends an Origin.
#
set -u

PORT="${CDP_PORT:-9222}"
DST="${CDP_PROFILE:-$HOME/.cache/cdp-mcp-profile}"
SRC="${CDP_SOURCE_PROFILE:-$HOME/Library/Application Support/Google/Chrome}"
PROFILE_DIR="${CDP_PROFILE_DIR:-Default}"
CHROME="${CDP_CHROME:-/Applications/Google Chrome.app}"   # .app bundle for open -a
ALLOW_ORIGINS="${CDP_ALLOW_ORIGINS-}"   # unset → empty → flag omitted (secure default)
CLAUDE_CONFIG="${CDP_CLAUDE_CONFIG:-$HOME/.claude.json}"   # MCP host config edited by `mode`
WATCH_SECONDS="${CDP_ALLOW_WATCH_SECONDS:-60}"            # `allow-watch` scan budget (seconds)
MARKER="$DST/.cdp-seeded-$PROFILE_DIR"  # per-profile; written "ok" only after a complete reseed

# A real CDP endpoint returns JSON containing webSocketDebuggerUrl. Use -f so HTTP
# 4xx/5xx from some *other* service squatting on the port counts as "down", and
# grep the payload so only a genuine DevTools endpoint counts as "up".
is_up() {
  curl -fsS --max-time 2 "http://127.0.0.1:$PORT/json/version" 2>/dev/null \
    | grep -q "webSocketDebuggerUrl"
}

# True if any Chrome is currently running against the dedicated profile dir, on ANY
# port — more reliable than the port check for "is it safe to overwrite the profile".
profile_in_use() { pgrep -f -- "--user-data-dir=$DST" >/dev/null 2>&1; }

seeded() { [ "$(cat "$MARKER" 2>/dev/null)" = "ok" ]; }

start() {
  if is_up; then
    # A DevTools endpoint answers on $PORT — but is it OURS? Confirm the LISTEN socket
    # is held by a process running our --user-data-dir, so we don't silently bless an
    # unrelated Chrome/CDP tool squatting on the port (which the MCP would then drive).
    lp=$(lsof -ti "tcp:$PORT" -sTCP:LISTEN 2>/dev/null | head -1)
    if [ -n "$lp" ] && pgrep -f -- "--user-data-dir=$DST" 2>/dev/null | grep -qw "$lp"; then
      # It's our profile dir — but do its LIVE launch flags match what's requested now?
      # If you changed CDP_PROFILE_DIR or CDP_ALLOW_ORIGINS since it launched, "already
      # up" would be a lie (wrong session / still-403'ing). Detect and refuse.
      live=$(ps -ww -o command= -p "$lp" 2>/dev/null)
      mismatch=""
      pgrep -f -- "--profile-directory=$PROFILE_DIR" 2>/dev/null | grep -qw "$lp" \
        || mismatch="profile (CDP_PROFILE_DIR=\"$PROFILE_DIR\")"
      if [ -z "$mismatch" ] && [ -n "$live" ]; then
        # grep -F: compare the flag as a literal string (handles "*" and URLs safely).
        if [ -n "$ALLOW_ORIGINS" ]; then
          printf '%s' "$live" | grep -qF -- "--remote-allow-origins=$ALLOW_ORIGINS" \
            || mismatch="origin allowlist (CDP_ALLOW_ORIGINS)"
        elif printf '%s' "$live" | grep -qF -- "--remote-allow-origins="; then
          mismatch="origin allowlist (CDP_ALLOW_ORIGINS now unset, but it's running with one)"
        fi
      fi
      if [ -z "$mismatch" ]; then echo "already up on :$PORT"; exit 0; fi
      echo "already up on :$PORT, but its launch flags differ from your request: $mismatch." >&2
      echo "Quit it and re-run to apply the change:  lsof -ti tcp:$PORT | xargs kill" >&2
      exit 1
    fi
    echo "port $PORT already has a DevTools endpoint that is NOT the dedicated profile" >&2
    echo "($DST). Another Chrome or CDP tool is holding it — pointing the MCP here would" >&2
    echo "drive the wrong browser. Stop that listener (lsof -ti tcp:$PORT) or set a" >&2
    echo "different CDP_PORT, then retry." >&2
    exit 1
  fi
  if ! seeded; then
    echo "no valid seeded profile at $DST (seed marker missing or incomplete)"
    echo "run:  cdp-chrome reseed   (quit your main Chrome first for a clean copy)"
    exit 1
  fi
  # open -na launches a NEW instance even while your main Chrome is running. CHROME is
  # the .app BUNDLE path (open -a's selector). --remote-allow-origins is added ONLY when
  # CDP_ALLOW_ORIGINS is set (secure default: omitted). Quoted so the shell never globs "*".
  local args=(
    --remote-debugging-port="$PORT"
    --user-data-dir="$DST"
    --profile-directory="$PROFILE_DIR"
    --no-first-run --no-default-browser-check
  )
  [ -n "$ALLOW_ORIGINS" ] && args+=( --remote-allow-origins="$ALLOW_ORIGINS" )
  open -na "$CHROME" --args "${args[@]}" about:blank
  for _ in $(seq 1 20); do is_up && { echo "up on :$PORT"; exit 0; }; sleep 1; done
  echo "failed to come up on :$PORT"; exit 1
}

reseed() {
  if [ ! -d "$SRC/$PROFILE_DIR" ]; then
    echo "source profile not found: $SRC/$PROFILE_DIR" >&2
    echo "set CDP_SOURCE_PROFILE (user-data-dir) and/or CDP_PROFILE_DIR (e.g. \"Profile 1\")" >&2
    exit 1
  fi
  # Refuse if the dedicated profile is live (on ANY port) — copying over an in-use
  # profile dir corrupts it. Checks the process's --user-data-dir, not just the port.
  if profile_in_use; then
    echo "a Chrome is running against $DST (the dedicated profile)" >&2
    echo "quit that instance first, then re-run: cdp-chrome reseed" >&2
    exit 1
  fi
  mkdir -p "$DST/$PROFILE_DIR"
  printf 'in-progress\n' > "$MARKER"   # invalidate the marker until this reseed completes
  echo "re-seeding $DST/$PROFILE_DIR from $SRC/$PROFILE_DIR (caches excluded, mirror)…"
  # --delete makes this a true fresh snapshot: files removed from the source
  # (logged-out cookies, deleted extensions, reset site data) are removed from the
  # copy too. Cache-y dirs and Singleton* lock files are excluded.
  rsync -a --delete \
    --exclude 'Cache/' --exclude 'Code Cache/' --exclude 'GPUCache/' \
    --exclude 'CacheStorage/' --exclude 'ScriptCache/' --exclude 'GrShaderCache/' \
    --exclude 'ShaderCache/' --exclude 'GraphiteDawnCache/' --exclude 'DawnGraphiteCache/' \
    --exclude 'DawnWebGPUCache/' --exclude 'component_crx_cache/' \
    --exclude 'optimization_guide_model_store/' --exclude 'Singleton*' \
    "$SRC/$PROFILE_DIR/" "$DST/$PROFILE_DIR/" || {
      echo "reseed FAILED: rsync error — the profile copy is incomplete and was NOT" >&2
      echo "marked seeded (marker left 'in-progress'); 'start' will refuse it. Fix the" >&2
      echo "cause (disk space, permissions, quit source Chrome) and re-run." >&2
      exit 1
    }
  # Local State holds os_crypt metadata + profile registry; it must copy too, or the
  # snapshot is inconsistent — propagate failure instead of marking seeded.
  if [ -f "$SRC/Local State" ] && ! cp -f "$SRC/Local State" "$DST/Local State"; then
    echo "reseed FAILED: could not copy 'Local State' (disk/permissions) — NOT marked" >&2
    echo "seeded; start will refuse it. Fix the cause and re-run." >&2
    exit 1
  fi
  printf 'ok\n' > "$MARKER"            # mark seeded only after a complete copy
  echo "reseed done"
}

config() {
  cat <<EOF
Point your CDP client at the dedicated instance. For chrome-devtools-mcp, set its
args (e.g. in ~/.claude.json under mcpServers.chrome-devtools.args):

  ["chrome-devtools-mcp@latest", "--browserUrl", "http://127.0.0.1:$PORT"]

(Replace any "--autoConnect" arg. Restart the MCP host for it to take effect.)
EOF
}

# mode [copied|autoconnect] — flip chrome-devtools-mcp's attach mode by rewriting
#   mcpServers.chrome-devtools.args in $CLAUDE_CONFIG. No arg = show the current mode.
#   The JSON edit is done in Python (present on this Mac): it backs the file up first,
#   preserves the package spec + any extra user flags, swaps only the connection flag,
#   then re-parses the result to validate (restoring the backup if it's not valid JSON).
mode() {
  local want="${1:-}"
  command -v python3 >/dev/null 2>&1 || {
    echo "mode needs python3 to edit $CLAUDE_CONFIG safely, but python3 was not found." >&2
    exit 1
  }
  [ -f "$CLAUDE_CONFIG" ] || {
    echo "MCP host config not found: $CLAUDE_CONFIG" >&2
    echo "(override with CDP_CLAUDE_CONFIG=/path/to/config)" >&2
    exit 1
  }
  case "$want" in
    ""|show)
      python3 - "$CLAUDE_CONFIG" <<'PY'
import json, sys
path = sys.argv[1]
try:
    d = json.load(open(path, encoding='utf-8'))
except Exception as e:
    print(f"could not parse {path}: {e}"); sys.exit(1)
def collect(d):
    hits = []
    ms = d.get('mcpServers')
    if isinstance(ms, dict) and isinstance(ms.get('chrome-devtools'), dict):
        hits.append(('mcpServers', ms['chrome-devtools']))
    for name, proj in (d.get('projects') or {}).items():
        if isinstance(proj, dict):
            pms = proj.get('mcpServers')
            if isinstance(pms, dict) and isinstance(pms.get('chrome-devtools'), dict):
                hits.append((f'projects[{name}]', pms['chrome-devtools']))
    return hits
hits = collect(d)
if not hits:
    print("no chrome-devtools MCP server found in this config."); sys.exit(0)
for where, srv in hits:
    args = srv.get('args') or []
    if '--autoConnect' in args:
        m = 'autoconnect (--autoConnect → real Chrome, dialog per session)'
    elif '--browserUrl' in args:
        i = args.index('--browserUrl')
        url = args[i+1] if i+1 < len(args) else '?'
        m = f'copied (--browserUrl {url} → dedicated copied-profile Chrome)'
    else:
        m = 'unknown (neither --autoConnect nor --browserUrl present)'
    print(f'{where}: {m}')
PY
      exit 0 ;;
    copied|autoconnect) : ;;
    *) echo "usage: cdp-chrome mode [copied|autoconnect]   (no arg = show current)" >&2; exit 2 ;;
  esac

  # Back up first (timestamped, never clobbering an earlier backup), then edit + validate.
  local backup; backup="$CLAUDE_CONFIG.cdp-chrome-bak-$(date +%Y%m%d-%H%M%S)"
  cp -p "$CLAUDE_CONFIG" "$backup" || { echo "could not back up $CLAUDE_CONFIG" >&2; exit 1; }

  if python3 - "$want" "$PORT" "$CLAUDE_CONFIG" "$backup" <<'PY'
import json, sys
mode, port, path, backup = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
try:
    d = json.load(open(path, encoding='utf-8'))
except Exception as e:
    print(f"refusing to edit — {path} is not valid JSON as-is: {e}", file=sys.stderr); sys.exit(1)

def collect(d):
    hits = []
    ms = d.get('mcpServers')
    if isinstance(ms, dict) and isinstance(ms.get('chrome-devtools'), dict):
        hits.append(ms['chrome-devtools'])
    for proj in (d.get('projects') or {}).values():
        if isinstance(proj, dict):
            pms = proj.get('mcpServers')
            if isinstance(pms, dict) and isinstance(pms.get('chrome-devtools'), dict):
                hits.append(pms['chrome-devtools'])
    return hits

def rebuild(args):
    # Drop existing connection flags (and --browserUrl's value); keep the package
    # spec at index 0 and every other flag the user has set; then append the new one.
    out, skip = [], False
    for a in args:
        if skip:
            skip = False; continue
        if a == '--autoConnect':
            continue
        if a == '--browserUrl':
            skip = True; continue
        out.append(a)
    if mode == 'copied':
        out += ['--browserUrl', f'http://127.0.0.1:{port}']
    else:
        out += ['--autoConnect']
    return out

hits = collect(d)
if not hits:
    print("no chrome-devtools MCP server found — add one first (see `cdp-chrome config`).",
          file=sys.stderr)
    sys.exit(3)
for srv in hits:
    srv['args'] = rebuild(srv.get('args') or [])

s = json.dumps(d, indent=2, ensure_ascii=False)
open(path, 'w', encoding='utf-8').write(s)
# Validate: re-parse what we just wrote; on any failure restore the backup.
try:
    json.load(open(path, encoding='utf-8'))
except Exception as e:
    import shutil; shutil.copyfile(backup, path)
    print(f"edit produced invalid JSON ({e}); restored from backup.", file=sys.stderr)
    sys.exit(1)
PY
  then
    echo "switched chrome-devtools-mcp to '$want' mode in $CLAUDE_CONFIG (backup: $backup)"
    echo "Reconnect the MCP: run /mcp in Claude Code (or restart the MCP host) to apply it."
    if [ "$want" = "copied" ]; then
      echo "Reminder: copied mode attaches to the dedicated Chrome — make sure it's up:"
      echo "  cdp-chrome start   (seed once with: cdp-chrome reseed)"
    else
      echo "Reminder: autoconnect drives your REAL Chrome and pops 'Allow remote debugging?'"
      echo "each session. To auto-click it (EXPERIMENTAL):  cdp-chrome allow-watch"
    fi
    exit 0
  else
    echo "mode switch failed — $CLAUDE_CONFIG left unchanged (backup: $backup)." >&2
    exit 1
  fi
}

# allow-watch — EXPERIMENTAL, autoconnect-mode helper.
#   chrome-devtools-mcp --autoConnect makes Chrome 144+ pop a native, un-suppressible
#   "Allow remote debugging?" bubble every session; Google closed the persistence request
#   (chrome-devtools-mcp#825) "not planned". The ONLY way to keep autoConnect from blocking
#   is to click that dialog for you. This runs a BOUNDED macOS-accessibility loop (System
#   Events) that watches for Google Chrome's "Allow" button and clicks it — clicking every
#   match each pass because a known bug (#1794) can stack several dialogs. It is a fragile
#   workaround of last resort, NOT a supported Chrome mechanism. Needs a one-time
#   Accessibility + Automation grant for whatever runs osascript (Terminal / Claude).
CLICK_SCRIPT='on run
  set clickedCount to 0
  try
    tell application "System Events"
      if not (exists process "Google Chrome") then return "no-chrome"
      tell process "Google Chrome"
        with timeout of 4 seconds
          repeat with w in windows
            try
              repeat with el in (entire contents of w)
                try
                  if (role of el is "AXButton") and (name of el is "Allow") then
                    click el
                    set clickedCount to clickedCount + 1
                  end if
                end try
              end repeat
            end try
          end repeat
        end timeout
      end tell
    end tell
  on error errMsg number errNum
    return "error:" & errNum & ":" & errMsg
  end try
  return "clicked:" & clickedCount
end run'

allow_watch() {
  command -v osascript >/dev/null 2>&1 || { echo "osascript not found (macOS only)." >&2; exit 1; }
  echo "cdp-chrome allow-watch (EXPERIMENTAL): watching for Chrome's 'Allow remote debugging?'"
  echo "dialog for ${WATCH_SECONDS}s and clicking Allow. Trigger your autoConnect CDP call now."
  # Preflight one pass: surfaces missing Accessibility/Automation permission immediately
  # instead of failing silently for the whole window. Both are needed — Automation to talk
  # to System Events, Accessibility to read/click other apps' UI elements.
  local out rc
  out="$(osascript -e "$CLICK_SCRIPT" 2>&1)"; rc=$?
  if [ $rc -ne 0 ] || printf '%s' "$out" | grep -Eq -- '-1743|-25211|not allowed|Not authorized'; then
    echo "" >&2
    echo "Accessibility/Automation permission is not granted for whatever runs osascript." >&2
    echo "osascript said: $out" >&2
    echo "Grant it ONCE, then re-run:" >&2
    echo "  System Settings → Privacy & Security → Accessibility  → enable your terminal" >&2
    echo "  System Settings → Privacy & Security → Automation      → allow it to control" >&2
    echo "                                                          'System Events'" >&2
    echo "(whatever process launches this — Terminal / iTerm / Ghostty / the Claude app)." >&2
    exit 1
  fi
  # Bounded poll: ~1 pass/sec up to WATCH_SECONDS. Keep clicking every pass (stacked-dialog
  # bug #1794). Stop early once we've clicked at least one AND then see 3 clean passes.
  local total=0 clean=0 i
  for i in $(seq 1 "$WATCH_SECONDS"); do
    out="$(osascript -e "$CLICK_SCRIPT" 2>/dev/null)"
    case "$out" in
      clicked:0|no-chrome) [ "$total" -gt 0 ] && clean=$((clean+1)) ;;
      clicked:*)
        n="${out#clicked:}"; total=$((total+n)); clean=0
        echo "clicked Allow x$n (total $total)" ;;
      *) : ;;  # timeout / transient a11y hiccup — ignore, retry next tick
    esac
    [ "$total" -gt 0 ] && [ "$clean" -ge 3 ] && break
    sleep 1
  done
  if [ "$total" -gt 0 ]; then
    echo "done: clicked Allow $total time(s)."
  else
    echo "done: no 'Allow' dialog appeared in ${WATCH_SECONDS}s (nothing clicked)."
    echo "If the prompt never showed, autoConnect may not have been triggered, or the button"
    echo "label/locale differs. This helper is best-effort — see SKILL.md caveats."
  fi
}

case "${1:-start}" in
  start)  start ;;
  reseed) reseed ;;
  status) is_up && echo "up on :$PORT" || echo "down" ;;
  config) config ;;
  mode)   mode "${2:-}" ;;
  allow-watch) allow_watch ;;
  -h|--help|help) sed -n '2,52p' "$0" ;;
  *) echo "usage: cdp-chrome {start|reseed|status|config|mode|allow-watch}"; exit 2 ;;
esac
